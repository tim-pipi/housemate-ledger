# Postgres connection string (Supabase: Settings -> Database -> Connection string -> URI)
# Use the "Transaction" pooler string (port 6543) for Vercel, and append ?sslmode=require if needed
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Any long random string; used to sign session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=change-me

# Shared secret protecting /api/cron and /api/digest. Vercel sends it automatically as
# "Authorization: Bearer <CRON_SECRET>" when the env var is set. Generate with: openssl rand -hex 32
CRON_SECRET=change-me-too

# Telegram bot token from @BotFather (see docs/telegram.md for setup steps)
TELEGRAM_BOT_TOKEN=

# Shared secret for the Telegram webhook, sent back as the
# X-Telegram-Bot-Api-Secret-Token header. Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Public app URL (no trailing slash), used to build links in Telegram messages
APP_URL=https://your-app.vercel.app
