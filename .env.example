# Postgres connection string (Supabase: Settings -> Database -> Connection string -> URI)
# Use the "Transaction" pooler string (port 6543) for Vercel, and append ?sslmode=require if needed
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Any long random string; used to sign session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=change-me
